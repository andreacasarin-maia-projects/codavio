{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codavio-recovery.mjs\"",
            "statusMessage": "Codavio-recovery",
            "timeout": 5,
            "additionalContextLimit": 1500
          }
        ]
      }
    ]
  }
}
