{
  "name": "codavio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "An adaptable development workflow for coding agents",
  "author": "Andrea Casarin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreacasarin-maia-projects/codavio.git"
  },
  "homepage": "https://github.com/andreacasarin-maia-projects/codavio#readme",
  "bugs": {
    "url": "https://github.com/andreacasarin-maia-projects/codavio/issues"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-strip-types --test tests/pi-command-policy.test.ts",
    "check": "npm run validate && npm test"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "development-workflow",
    "opencode",
    "pi-package",
    "codex"
  ],
  "dependencies": {
    "pi-subagents": "0.35.1"
  },
  "pi": {
    "subagents": {
      "agents": [
        "./pi/agents"
      ]
    },
    "prompts": [
      "./pi/prompts"
    ],
    "extensions": [
      "./pi/extensions/workflow.ts",
      "./pi/extensions/coordinator-guard.ts",
      "./pi/extensions/builder-guard.ts",
      "./pi/extensions/reviewer-guard.ts",
      "./pi/extensions/shipper-guard.ts"
    ]
  }
}
