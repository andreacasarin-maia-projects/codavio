{
  "name": "ai-dev-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "Pi package for the AI development workflow",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate.mjs",
    "test": "node --experimental-strip-types --test tests/pi-command-policy.test.ts",
    "check": "npm run validate && npm test"
  },
  "keywords": [
    "pi-package"
  ],
  "dependencies": {
    "pi-subagents": "0.35.1"
  },
  "pi": {
    "subagents": {
      "agents": [
        "./pi/agents"
      ]
    },
    "prompts": [
      "./pi/prompts"
    ],
    "extensions": [
      "./pi/extensions/workflow.ts",
      "./pi/extensions/coordinator-guard.ts",
      "./pi/extensions/builder-guard.ts",
      "./pi/extensions/reviewer-guard.ts",
      "./pi/extensions/shipper-guard.ts"
    ]
  }
}
